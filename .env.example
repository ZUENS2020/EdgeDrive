# Auth mode: password (default) | oauth | access
# Aliases: better-auth → password, none → access
AUTH_MODE=password

# Required when AUTH_MODE=password or oauth
BETTER_AUTH_SECRET=replace-with-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first boot when AUTH_MODE=password. Ignored if an admin already exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AUTH_MODE=oauth: GitHub and/or Google. Only configured providers appear on /login.
# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
#           {BETTER_AUTH_URL}/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional extra allowlist (also editable in /admin/settings):
# OAUTH_ALLOW_EMAILS=you@example.com

# Optional. POST /api/cron/purge with Authorization: Bearer <secret>
# CRON_SECRET=

# Optional: Cloudflare (CI / wrangler). Never commit real values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
