# Auth mode: better-auth (default) | none (skip app auth; protect /admin* with Cloudflare Access)
AUTH_MODE=better-auth

# Required when AUTH_MODE=better-auth
BETTER_AUTH_SECRET=replace-with-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first boot into D1 `admin` table (bcrypt). Ignored if an admin already exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: Cloudflare (CI / wrangler). Never commit real values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
