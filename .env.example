# Local Next.js only. Do not commit `.env.local`.
# Production secrets belong on the Cloudflare Worker (Dashboard → Settings → Variables and Secrets), not here.

# Auth mode: password (default) | access
# Aliases: none / oauth → access. GitHub / Google 请走 Cloudflare Access，不要配在本应用里。
AUTH_MODE=password

BETTER_AUTH_SECRET=replace-with-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first boot when AUTH_MODE=password. Ignored if an admin already exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

CRON_SECRET=

# Optional Encrypted secrets on the Worker. NULL = unset.
# Account Analytics Read enables /admin/usage GraphQL metrics.
CLOUDFLARE_ACCOUNT_ID=NULL
CLOUDFLARE_API_TOKEN=NULL
