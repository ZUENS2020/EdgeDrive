{
  "name": "edgedrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cf-build.mjs",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "npm run build && npm run cf-deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-build": "node scripts/cf-build.mjs",
    "cf-deploy": "node scripts/cf-deploy.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "postinstall": "node scripts/install-wrangler-shim.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "^6.0.0-beta.14",
    "@mui/material": "^6.5.0",
    "@mui/x-data-grid": "^7.29.13",
    "@opennextjs/cloudflare": "^1.20.2",
    "@refinedev/core": "^5.0.12",
    "@refinedev/mui": "^8.0.2",
    "@refinedev/nextjs-router": "^7.0.5",
    "@refinedev/simple-rest": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}
