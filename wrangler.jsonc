{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Dashboard → 该 Worker → Settings → Build
  // Build command:  npm run build
  // Deploy command: npm run cf-deploy
  //
  // name / D1 / R2 都是占位默认值。先在账号里创建资源，再把名称和 database_id 改成真实的。
  "name": "dl-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Dashboard 里改过的明文 vars 不要被下次部署清掉。Encrypted secrets 本来就会保留。
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dl-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "dl-files"
    }
  ],
  "vars": {
    // 非密钥明文。账密、CLOUDFLARE_* 走 Encrypted secrets，不要写在这里。
    "AUTH_MODE": "password",
    "CF_WORKER_NAME": "dl-platform",
    "CF_R2_BUCKET": "dl-files",
    "CF_D1_DATABASE_ID": "00000000-0000-0000-0000-000000000000"
  }
}
