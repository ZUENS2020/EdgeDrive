{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 创建页往往只让填构建命令：npm run build。
  // 部署走默认 npx wrangler deploy；postinstall 包装 wrangler，接着跑 D1 迁移。
  // 登录和管理员配置在 D1，不写进 Variables and Secrets。
  //
  // 只声明绑定名。不要填 database_id / bucket_name，否则会写死某一套资源。
  // 新 Worker 第一次部署会自动建 D1（DB）和 R2（FILES）。
  // 已经在 Settings → Bindings 里绑过的，会沿用，不会另建。
  "name": "edgedrive",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}
