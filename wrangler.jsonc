{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuens-dl-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuens-dl-db",
      "database_id": "ce85bf1b-9a70-4827-b11b-0df8c3387fd9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zuens-dl"
    }
  ],
  "vars": {
    // 非密钥明文。账密、CLOUDFLARE_API_TOKEN 等不要写在这里（后者会和 CI 部署鉴权撞名）。
    "AUTH_MODE": "better-auth",
    "CF_WORKER_NAME": "zuens-dl-platform",
    "CF_R2_BUCKET": "zuens-dl",
    "CF_D1_DATABASE_ID": "ce85bf1b-9a70-4827-b11b-0df8c3387fd9"
  }
}
