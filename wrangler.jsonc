{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers Builds 会按 Next.js / OpenNext 自动填构建和部署命令，
  // 不用改。常见是 npm run build + npx wrangler deploy，也可能是
  // npx opennextjs-cloudflare build / deploy。仓库里的 npm run build 就是
  // OpenNext；npx wrangler deploy 会走 postinstall 装上的 shim
  //（不自动建 D1/R2，并种密钥名）。
  //
  // 只声明绑定名。不要填 database_id / bucket_name，否则会写死资源、
  // 也会在第一次部署时自动建新库和新桶。
  // 请先在账号里自己创建 D1 和 R2，再到该 Worker → Settings → Bindings
  // 把 D1 绑成 DB、R2 绑成 FILES。之后部署会沿用界面上的绑定。
  "name": "dl-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Dashboard 里改过的明文 vars 不要被下次部署清掉。Encrypted secrets 本来就会保留。
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
  // AUTH_MODE 和账密等全部走 Encrypted secrets，部署后由脚本种上字段名。
  // 不要写进 vars，否则下次部署会盖掉 Dashboard 里改过的值。
}
